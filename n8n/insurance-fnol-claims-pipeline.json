      },
      "id": "d13ccca4-5fe8-5889-8cd7-44cc93836f38",
      "name": "Damage Assessment (Gemini Vision)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2640,
        100
      ],
      "credentials": {
        "httpQueryAuth": {
          "id": "",
          "name": "Query Auth account"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json?.candidates?.[0]?.content?.parts?.[0]?.text || '';\nlet p = null;\ntry { p = JSON.parse(raw.replace(/```json|```/g, '').trim()); } catch (e) {}\nconst score = p && p.damage_score !== undefined ? Math.min(1, Math.max(0, Number(p.damage_score) || 0)) : null;\nreturn [{ json: {\n  damage_score: score,\n  summary: p?.summary ? String(p.summary).slice(0, 600) : 'Photo assessment failed; adjuster should review photos manually.',\n} }];"
      },
