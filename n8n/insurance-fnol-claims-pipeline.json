    {
      "parameters": {
        "jsCode": "const b = $('FNOL Intake Webhook').first().json.body || {};\nconst str = v => (v === undefined || v === null) ? '' : String(v).trim();\nconst errors = [];\nconst policyNumber = str(b.policyNumber);\nconst incidentDescription = str(b.incidentDescription);\nconst policyholderEmail = str(b.policyholderEmail).toLowerCase();\nif (!policyNumber) errors.push('policyNumber is required');\nif (incidentDescription.length < 10) errors.push('incidentDescription must be at least 10 characters');\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(policyholderEmail)) errors.push('policyholderEmail must be a valid email');\nconst photos = (Array.isArray(b.photos) ? b.photos : [])\n  .map(str).filter(u => /^https:\\/\\//i.test(u)).slice(0, 4);\nconst rand = Math.random().toString(36).slice(2, 7).toUpperCase();\nreturn [{ json: {\n  valid: errors.length === 0,\n  errors,\n  claimRef: `CLM-${$now.toFormat('yyyyMMdd')}-${rand}`,\n  policyNumber,\n  incidentDescription: incidentDescription.slice(0, 4000),\n  incidentDate: str(b.incidentDate),\n  policyholderEmail,\n  policyholderPhone: str(b.policyholderPhone),\n  photos,\n  lineOfBusiness: str(b.lineOfBusiness) || 'unspecified',\n  tenantId: str(b.tenantId),\n} }];"
      },
