        "jsonBody": "={{ JSON.stringify({ contents: [{ role: 'user', parts: [ { text: 'Assess the vehicle or property damage shown in these claim photos. Return JSON: {\"damage_score\": number 0-1 where 1 is total loss, \"summary\": string (max 2 sentences)}. If the images do not show damage, say so and use a low score.' }, ...($('Validate & Normalize').first().json.photos.map(url => ({ file_data: { file_uri: url, mime_type: /\\.png($|\\?)/i.test(url) ? 'image/png' : 'image/jpeg' } }))) ] }], generationConfig: { temperature: 0, responseMimeType: 'application/json' } }) }}",
        "options": {
          "timeout": 90000
